# --- MBiotrack-EMS Frontend Environment Configuration ---

# API Base URL for backend requests.
# In local development, leave this empty to use the Vite reverse proxy (relative paths).
# In production (e.g. Render Static Site), set this to the backend Web Service URL:
# Example: VITE_API_BASE_URL=https://<your-backend-service>.onrender.com
# Note: All VITE_ variables are embedded in the client JavaScript bundle at build time.
# NEVER place secrets, private keys, or passwords in frontend environment variables.
VITE_API_BASE_URL=
