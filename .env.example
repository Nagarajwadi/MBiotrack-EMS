# --- MBiotrack-EMS Environment Configuration ---

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MBiotrack-EMS"

# Server & Network
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local PostgreSQL Development Database
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:your_local_password@localhost:5432/mbiotrack_dev

# Dedicated Isolated Test Database (Database name must end with _test)
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_local_password@localhost:5432/mbiotrack_test

# Database Pool Settings
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Authentication and JWT configuration
# Development-only placeholder. Generate a strong random secret for production.
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
TOKEN_ISSUER=mbiotrack-ems

# Optional separate HMAC secret for audit pseudonymization.
# Generate a separate strong secret if enabling this setting.
# AUDIT_HMAC_SECRET=

# Reverse proxy trust is disabled by default.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=[]


